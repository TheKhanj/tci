#!/usr/bin/env bash

set -euo pipefail

html=$(cat "${1:-/dev/stdin}")

extract() {
	local q="$1"
	shift
	htmlq -t "$q" "$@" <<<"$html" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//'
}

normalize() {
	local value=$1

	printf '%s' "$value" |
		sed \
			-e 'y/۰۱۲۳۴۵۶۷۸۹/0123456789/' \
			-e 's/٫/./g'
}

extract_internet() {
	local service
	service=$(extract '.tm-card-body h5' | head -n 1)

	local reserved
	reserved=$(extract '.tm-card-body h5:nth-of-type(2)' |
		grep -oE -- '-?[۰۱۲۳۴۵۶۷۸۹0-9]+([٫.][۰۱۲۳۴۵۶۷۸۹0-9]+)?' | head -n 1)

	local bundled
	bundled=$(extract '.tm-card-body h5:nth-of-type(3)' |
		grep -oE -- '-?[۰۱۲۳۴۵۶۷۸۹0-9]+([٫.][۰۱۲۳۴۵۶۷۸۹0-9]+)?' | head -n 1)

	# Extract remaining days.
	local days
	days=$(extract '.chart[title] .percent span' |
		grep -o '[۰۱۲۳۴۵۶۷۸۹]\+' | head -n 1)
	local total_days
	total_days=$(extract '.chart[title] .percent span' |
		grep -o '[۰۱۲۳۴۵۶۷۸۹]\+' | tail -n 1)

	# Extract expiration date.
	local expires
	expires=$(extract '.chart' --attribute title)

	# Extract remaining traffic.
	local traffic
	traffic=$(extract '.chart:not([title]) .percent span[dir="ltr"]' |
		head -n 1)

	local total_traffic
	total_traffic=$(extract '.chart:not([title]) .percent span[dir="ltr"]' |
		tail -n 1)

	jq -n \
		--arg service "$(normalize "$service")" \
		--arg reserved "$(normalize "$reserved")" \
		--arg bundled "$(normalize "$bundled")" \
		--arg days "$(normalize "$days")" \
		--arg total_days "$(normalize "$total_days")" \
		--arg expires "$(normalize "${expires#پایان: }")" \
		--arg traffic "$(normalize "${traffic%GB}")" \
		--arg total_traffic "$(normalize "${total_traffic%GB}")" \
		'{
				service: $service,
				reserved_traffic: ($reserved | tonumber),
				bundled_traffic: ($bundled | tonumber),
				days_remaining: ($days | tonumber),
				days_total: ($total_days | tonumber),
				expires_at: $expires,
				traffic_remaining: ($traffic | tonumber),
				traffic_total: ($total_traffic | tonumber)
    }'
}

extract_phone() {
	local bill
	bill=$(extract '.uk-alert-danger p' |
		grep -oE '[۰۱۲۳۴۵۶۷۸۹0-9]+' |
		head -n 1)

	local payment_url
	payment_url=$(htmlq -a href '.uk-alert-danger a' <<<"$html")

	jq -n \
		--arg amount "$(normalize "$bill")" \
		--arg payment_url "$payment_url" \
		'{
				amount: ($amount | tonumber),
				payment_url: $payment_url
    }'
}

extract_account() {
	local online ip started download upload
	local phone name country province city exchange registration subscription
	local credit mobile username platform

	online=$(extract '.uk-card-header .uk-card-badge')
	ip=$(extract '.uk-card-header .uk-card-badge tr:nth-of-type(1) td:nth-of-type(2)')
	started=$(extract '.uk-card-header .uk-card-badge tr:nth-of-type(2) td:nth-of-type(2)')
	download=$(extract '.uk-card-header .uk-card-badge tr:nth-of-type(3) td:nth-of-type(2)')
	upload=$(extract '.uk-card-header .uk-card-badge tr:nth-of-type(4) td:nth-of-type(2)')

	phone=$(extract '.uk-card-header .uk-text-meta span')
	name=$(extract '.uk-card-header h4')

	country=$(extract '.tm-card-body li:nth-of-type(1) b')
	province=$(extract '.tm-card-body li:nth-of-type(2) b')
	city=$(extract '.tm-card-body li:nth-of-type(3) b')
	exchange=$(extract '.tm-card-body li:nth-of-type(4) b')
	registration=$(extract '.tm-card-body li:nth-of-type(5) b')
	subscription=$(extract '.tm-card-body li:nth-of-type(6) b')
	credit=$(extract '.tm-card-body li:nth-of-type(7) b')
	mobile=$(extract '.tm-card-body li:nth-of-type(8) b')
	username=$(extract '.tm-card-body li:nth-of-type(9) b')
	platform=$(extract '.tm-card-body li:nth-of-type(10) b')

	jq -n \
		--arg online "$online" \
		--arg ip "$ip" \
		--arg started "$started" \
		--arg download "$download" \
		--arg upload "$upload" \
		--arg phone "$(normalize "$phone")" \
		--arg name "$name" \
		--arg country "$country" \
		--arg province "$province" \
		--arg city "$city" \
		--arg exchange "$exchange" \
		--arg registration "$(normalize "$registration")" \
		--arg subscription "$subscription" \
		--arg credit "$(normalize "$credit" | grep -o '[0-9]\+')" \
		--arg mobile "$(normalize "$mobile")" \
		--arg username "$username" \
		--arg platform "$platform" \
		'{
			online: ($online | contains("آنلاین")),
			phone: $phone,
			name: $name,
			location: {
				country: $country,
				province: $province,
				city: $city,
				exchange: $exchange
			},
			registration: $registration,
			subscription: $subscription,
			credit: $credit,
			mobile: $mobile,
			username: $username,
			platform: $platform,
			connection: {
				ip: $ip,
				started: $started,
				download: $download,
				upload: $upload
			}
		}'
}

main() {
	jq -n \
		--argjson phone "$(extract_phone)" \
		--argjson internet "$(extract_internet)" \
		--argjson account "$(extract_account)" \
		'{
			phone: $phone,
			internet: $internet,
			account: $account,
		}'
}

main
